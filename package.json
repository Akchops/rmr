{
  "name": "morphed-detailing-concept",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unofficial speculative website concept for Morphed Detailing Studio, Bengaluru.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node tools/prerender.mjs",
    "preview": "vite preview --port 4173",
    "assets": "node tools/render-assets.mjs",
    "fonts": "node tools/fetch-fonts.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}